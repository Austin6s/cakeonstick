---
/** Eyebrow + heading pairing used above every major section. */
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, align = 'left' } = Astro.props;
---

<div class:list={['section-heading', align === 'center' && 'is-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
</div>
