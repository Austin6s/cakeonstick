---
/**
 * A responsive, compressed photo: AVIF with a WebP fallback, in several widths,
 * with width and height set so the page does not jump while it loads.
 */
import type { ImageMetadata } from 'astro';
import { responsiveSources } from '../lib/images';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Candidate widths in pixels; anything wider than the source is dropped. */
  widths: number[];
  /** The `sizes` attribute: how wide the photo is shown. */
  sizes: string;
  class?: string;
  /** Load now and with high priority (the hero). Everything else loads lazily. */
  eager?: boolean;
  quality?: number;
  [attr: `data-${string}`]: string | undefined;
}
const { src, alt, widths, sizes, class: cls, eager = false, quality, ...rest } = Astro.props;
const { avif, webp } = await responsiveSources(src, widths, quality);
---

<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <img
    src={webp.src}
    srcset={webp.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={src.width}
    height={src.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    class={cls}
    {...rest}
  />
</picture>
