---
/**
 * The quick-order dialog for one gift set or party package. A native <dialog>:
 * the browser moves focus in, keeps it inside, closes on Esc and returns focus
 * to the button that opened it.
 *
 * The three ways to order are real links, so no pop-up blocker can stop them:
 *  - LINE: on a phone the chat opens with the message typed in. On a computer the
 *    message is copied and the LINE desktop app is opened; if it isn't installed, the
 *    add-friend QR page opens instead (src/scripts/site.ts).
 *  - Instagram: a DM can't be pre-filled, so the message is copied and the DM opens.
 *  - Email: the visitor's default mail app opens with the subject and message filled in.
 * The message and a Copy button are always shown, in case an app does not open.
 */
import type { ImageMetadata } from 'astro';
import type { Flavor, Strings } from '../content/types';
import { links } from '../lib/site';
import Photo from './Photo.astro';

interface Props {
  id: string;
  name: string;
  priceDisplay: string;
  photo?: ImageMetadata;
  flavors?: Flavor[];
  message: string;
  t: Strings;
}
const { id, name, priceDisplay, photo, flavors = [], message, t } = Astro.props;
---

<dialog class="order" id={`order-${id}`} aria-labelledby={`order-${id}-title`} data-message={message}>
  <div class="order-inner">
    {
      photo && (
        <Photo
          src={photo}
          alt=""
          widths={[440, 880]}
          sizes="(min-width: 440px) 440px, 100vw"
          class="order-photo"
        />
      )
    }
    <div class="order-content">
      <div class="order-head">
        <h2 id={`order-${id}-title`}>{name}</h2>
        <div class="order-price">{priceDisplay}</div>
      </div>
      {
        flavors.length > 0 && (
          <div>
            <p class="order-label">{t.orderFlavorsLabel}</p>
            <ul class="order-flavors">
              {flavors.map((fl) => (
                <li>
                  <span class="flavor-name">{fl.name}</span>
                  <span class="flavor-desc">{fl.desc}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p class="order-hint">{t.orderHint}</p>
      <div>
        <div class="order-msg-head">
          <p class="order-label">{t.orderMsgLabel}</p>
          <button class="order-copy" type="button" data-copy data-label={t.copyBtn} data-label-done={t.copiedBtn}>
            {t.copyBtn}
          </button>
        </div>
        <p class="order-message">{message}</p>
      </div>
      <div class="order-actions">
        <a
          class="order-line"
          href={links.lineMessageUrl(message)}
          target="_blank"
          rel="noopener"
          data-line-message
          data-app-url={links.lineAppMessageUrl(message)}
          data-add-url={links.lineAddUrl}
          data-desktop={t.orderLineDesktop}
          data-qr-opened={t.lineQrOpened}
          data-blocked={t.formBlocked}
        >
          {t.orderLineCta}
        </a>
        <a class="order-ig" href={links.igDmUrl} target="_blank" rel="noopener" data-copy-first data-copied={t.orderIgCopied}>
          {t.orderIgCta}
        </a>
        <a class="order-ig" href={links.mailtoWith(t.orderEmailSubject + name, message)} data-order-email>
          {t.orderEmailCta}
        </a>
      </div>
      <p class="order-copied" role="status" data-status data-copy-failed={t.copyFailed}></p>
      <a class="order-qr" href={links.lineAddUrl} target="_blank" rel="noopener" data-line-qr hidden>{t.lineQrLink}</a>
      <button class="order-cancel" type="button" data-close>{t.orderCancel}</button>
    </div>
  </div>
</dialog>
