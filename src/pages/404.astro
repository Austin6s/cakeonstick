---
import '../styles/tokens.css';
import '../styles/site.css';
import { homePath } from '../lib/site';
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Cake on Stick — 404</title>
  </head>
  <body>
    <main style="max-width: 560px; margin: 0 auto; padding: 96px var(--container-pad); text-align: center; line-height: var(--leading-body);">
      <h1 style="font-size: var(--size-display-md); margin: 0 0 16px;">404</h1>
      <p>找不到這個頁面。<a href={homePath('zh')}>回到首頁</a></p>
      <p lang="en">This page doesn't exist. <a href={homePath('en')}>Back to the home page</a></p>
    </main>
  </body>
</html>
