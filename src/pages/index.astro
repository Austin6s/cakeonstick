---
// Traditional Chinese (Taiwan): the default language, at the site root.
import HomePage from '../components/HomePage.astro';
import { homePath } from '../lib/site';

const enUrl = homePath('en');
---

<HomePage lang="zh">
  <!-- Runs before the page paints. A visitor who chose a language keeps it. Otherwise the
       browser's language list decides: the first entry that is Chinese or English wins,
       and a browser with neither gets English. Nothing is sent to any server.
       Search-engine crawlers are left on the page they asked for. -->
  <script is:inline slot="head-first" define:vars={{ enUrl }}>
    try {
      if (!/bot|crawl|spider|lighthouse/i.test(navigator.userAgent)) {
        var want = localStorage.getItem('cos-lang');
        if (want !== 'zh' && want !== 'en') {
          want = 'en';
          var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < list.length; i++) {
            var code = String(list[i]).toLowerCase();
            if (code.indexOf('zh') === 0 || code.indexOf('en') === 0) {
              want = code.slice(0, 2);
              break;
            }
          }
        }
        if (want === 'en') location.replace(enUrl + location.search + location.hash);
      }
    } catch (e) {}
  </script>
</HomePage>
